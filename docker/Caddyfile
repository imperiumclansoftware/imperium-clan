# Imperium Clan — un seul serveur (FrankenPHP = Caddy + PHP) pour le front Angular et l'API Symfony,
# sur le même site : pas de CORS, cookies SameSite.
{
	skip_install_trust
	admin off
	frankenphp
	servers {
		# Adresse client réelle derrière un reverse proxy (journaux Caddy). Symfony, lui, s'appuie sur TRUSTED_PROXIES.
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:private_ranges}
	}
}

# SERVER_NAME=:8080 (défaut) : HTTP derrière un reverse proxy qui termine TLS.
# SERVER_NAME=portail.exemple.fr : HTTPS automatique (Let's Encrypt) sur 80/443.
{$SERVER_NAME} {
	encode zstd br gzip

	# API Symfony : toujours servie par public/index.php (en-têtes posés par nelmio/security-bundle).
	handle /api/* {
		root * /app/public
		php_server {
			try_files /index.php
		}
	}

	# Application Angular.
	handle {
		root * /app/spa

		# En-têtes de sécurité (guidelines « En-têtes HTTP »). ProseMirrorClipboard : politique Trusted Types de
		# l'éditeur des actualités, utilisée pour lire le HTML collé ; le résultat est filtré par le schéma de l'éditeur.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types angular angular#bundler ProseMirrorClipboard"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Cross-Origin-Opener-Policy "same-origin"
			X-Frame-Options "DENY"
			-Server
		}

		# Fichiers hachés par le build : cache long. Fonds et logos : 1 jour. Tout le reste (index.html, routes) :
		# revalidé à chaque fois (« ? » = seulement si aucun Cache-Control n'est déjà posé).
		@hashed path_regexp -[A-Za-z0-9_-]{8}\.(js|css|woff2?|ttf)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@static path /brand/* /media/* /favicon.svg
		header @static Cache-Control "public, max-age=86400"
		header ?Cache-Control "no-cache"

		@maps path *.map
		respond @maps 404

		try_files {path} /index.html
		file_server
	}
}

# Sonde de santé interne (HEALTHCHECK Docker), jamais exposée : fonctionne quel que soit SERVER_NAME.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	handle /api/health {
		root * /app/public
		php_server {
			try_files /index.php
		}
	}
	respond 404
}
